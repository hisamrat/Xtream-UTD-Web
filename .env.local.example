# Google Sheets product source (optional — without it the bundled fallback catalogue is used).
# Never commit real values. Configure them in your hosting provider's environment settings.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Authenticate with EITHER a read-only API key (spreadsheet shared as "anyone with the link can view")…
# GOOGLE_SHEETS_API_KEY=your-google-cloud-api-key

# …OR a service account that has viewer access to the spreadsheet (scope: spreadsheets.readonly).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: sheet tab names (auto-detected when omitted).
# GOOGLE_SHEETS_PRODUCTS_TAB=Product Information Management
# GOOGLE_SHEETS_GALLERY_TAB=Product Image and Video Gallery

# Required to enable POST /api/revalidate (send it in the x-revalidate-token header).
# REVALIDATION_SECRET=a-long-random-string
